# Frontend Environment Variables
VITE_API_URL=
VITE_BACKEND_URL=http://localhost:3000
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Optional: configure a licensed XYZ tile provider for the property map.
# Keep the real value in .env; do not commit provider keys.
# Example CARTO URL: https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png?api_key=YOUR_CARTO_API_KEY
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=

# Address shown on the Help page for the "write to us" email fallback
VITE_SUPPORT_EMAIL=support@assetmap.in
