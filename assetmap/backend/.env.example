# ─────────────────────────────────────────────
# AssetMap Backend — Environment Variables
# Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://assetmap:assetmap_dev_password@localhost:5432/assetmap
# Postgres pool: keep (API instances x PG_POOL_MAX) + gateway + agent worker under ~80% of max_connections
PG_POOL_MAX=20
# Cancel any single query running longer than this (0 = no limit)
PG_STATEMENT_TIMEOUT_MS=15000
# Max time to drain requests/jobs on SIGTERM before forcing exit
SHUTDOWN_TIMEOUT_MS=25000
# Application Insights (leave empty to disable telemetry). Fraction of traces kept (0-1].
# OTEL_TRACES_SAMPLER / OTEL_TRACES_SAMPLER_ARG, if set, override this ratio.
APPLICATIONINSIGHTS_CONNECTION_STRING=
APPINSIGHTS_SAMPLING_RATIO=0.25
# Run the in-process cron jobs and BullMQ workers (alerts, land sync, net worth, classifier...).
# In Azure this MUST be a deployment-slot (sticky) setting: false on the staging slot, true on
# production. A swap then starts jobs only in the release that goes live, and the old release left
# in staging comes back up with them off. Otherwise both slots run every job against prod data.
RUN_BACKGROUND_JOBS=true
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Encryption & Security
ENCRYPTION_KEY=               # 32-byte hex key for AES-256 (64 hex chars)
AADHAAR_SALT=                  # Random salt for Aadhaar SHA-256 hashing
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n..."
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n..."
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
COOKIE_SECRET=                 # 32+ random bytes for cookie signing

# Identity & KYC Providers
KYC_PROVIDER=uidai             # uidai | surepass | mock
UIDAI_API_URL=https://developer.uidai.gov.in
UIDAI_AUA_CODE=
UIDAI_ASA_CODE=
UIDAI_LICENSE_KEY=
UIDAI_PRIVATE_KEY=             # For e-KYC XML signing (PEM, base64 encoded)
UIDAI_PUBLIC_CERT=

# Surepass (Land & Ancestral Search)
SUREPASS_API_URL=https://kyc-api.surepass.io
SUREPASS_TOKEN=

# Zoop.one (Land Records)
ZOOP_API_URL=https://prod.aadhaarapi.com/api/v1
ZOOP_APP_ID=
ZOOP_API_KEY=

# Setu Account Aggregator
SETU_AA_BASE_URL=https://aa-sandbox.setu.co
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_PRODUCT_INSTANCE_ID=
SETU_WEBHOOK_SECRET=
SETU_FIU_ENTITY_ID=

# DigiLocker
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_PRODUCT_INSTANCE_ID=
DIGILOCKER_REDIRECT_URI=http://localhost:3000/api/digilocker/callback

# AWS S3
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_DOCUMENTS=assetmap-documents-dev

# Communication & Notifications (Resend / Twilio / SMTP)
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev
# Support tickets from the Help page are forwarded here (optional; tickets are always stored)
SUPPORT_INBOX_EMAIL=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# CAMS Mutual Funds Integration
CAMS_API_URL=https://api.camsonline.com/v1
CAMS_API_KEY=
CAMS_API_SECRET=

# External Services
UMANG_API_KEY=
ZOHO_SIGN_TOKEN=
TERM_AFFILIATE_URL=
HEALTH_AFFILIATE_URL=

# Recovery Engine & Payments
LEGAL_ENTITY_NAME="AssetMap Recovery Services Pvt. Ltd."
SUCCESS_FEE_MIN_PCT=5
SUCCESS_FEE_MAX_PCT=10
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI Integration
ANTHROPIC_API_KEY=
# Automated first reply on new support tickets (only runs when ANTHROPIC_API_KEY is set)
SUPPORT_AI_ASSISTANT=true

# Testing
MOCK_MODE=false
# Local only: allow credential-less /api/auth/dev-login (requires NODE_ENV=development)
ENABLE_DEV_LOGIN=false
# Proxy hops in front of the API (Azure App Service = 1). Defaults to 1 in production, 0 otherwise.
TRUST_PROXY_HOPS=
