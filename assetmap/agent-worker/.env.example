# AssetMap agent worker. Every variable the code reads is listed here.
# Required: DATABASE_URL, REDIS_URL, ENCRYPTION_KEY. Everything else is optional.

NODE_ENV=development

# Database — the AssetMap Postgres (needs backend migrations 032 and 034 applied)
DATABASE_URL=postgresql://user:password@localhost:5432/assetmap
# Pool size (default 5). Each in-flight run holds one connection for its whole run.
AGENT_PG_POOL_MAX=5
# Parallel runs (default 3, capped at AGENT_PG_POOL_MAX - 1)
AGENT_CONCURRENCY=3

# Redis (BullMQ) — must be the SAME Redis the backend enqueues to.
# Local dev: the backend uses REDIS_HOST/REDIS_PORT (127.0.0.1:6379) in development,
# so do not copy the backend's REDIS_URL here. rediss:// enables TLS (Azure Cache for Redis).
REDIS_URL=redis://127.0.0.1:6379

# AES-256-GCM key — 64 hex chars. Must be the SAME key the backend uses: the worker
# decrypts users.*_encrypted, asset_snapshots_aa, land_records and unclaimed_assets_found.
ENCRYPTION_KEY=

# Anthropic (optional). Without a key, or if the key is rejected, runs use the
# deterministic pipeline with default enrichment and end 'partial'.
ANTHROPIC_API_KEY=
# Step routing model (default claude-haiku-5-5)
ANTHROPIC_MODEL=
# Enrichment model (default claude-sonnet-5-5)
ANTHROPIC_ENRICH_MODEL=

# DigiLocker and MCA21 call external APIs directly (the backend has no storage for them).
# Off unless set to true.
AGENT_ENABLE_EXTERNAL_SOURCES=false

# Liveness file, rewritten every 30s while healthy (health check: mtime < 2 min)
AGENT_HEARTBEAT_FILE=/tmp/agent-worker.heartbeat

# Max users the daily catch-up enqueues per tick (default 2000)
AGENT_CATCHUP_MAX_USERS=2000
