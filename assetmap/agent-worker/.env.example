# Database — the AssetMap Postgres (needs backend migration 032_agent_orchestration.sql applied)
DATABASE_URL=postgresql://user:password@localhost:5432/assetmap

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Anthropic
ANTHROPIC_API_KEY=
# Optional; defaults to claude-sonnet-4-6
ANTHROPIC_MODEL=

# AES-256-GCM key — 64 hex chars, generate with: openssl rand -hex 32
# Must be the SAME key AssetMap uses: the scheduler decrypts users.*_encrypted.
ENCRYPTION_KEY=

# Setu Account Aggregator (FIU v2)
SETU_AA_BASE_URL=https://fiu-sandbox.setu.co
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_PRODUCT_INSTANCE_ID=

# Surepass (land records)
SUREPASS_API_URL=
SUREPASS_TOKEN=

# DigiLocker
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
